{
  "name": "capubbs-forum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host localhost",
    "typecheck": "tsc -b --pretty false",
    "verify:default-signature": "node --experimental-strip-types verify-default-signature.mjs",
    "verify:floor-quotes": "node --experimental-strip-types verify-floor-quotes.mjs",
    "verify:font-sizes": "node --experimental-strip-types verify-forum-font-sizes.mjs",
    "verify:forum-mode": "node --experimental-strip-types verify-forum-mode.mjs",
    "verify:legacy-assets": "node --experimental-strip-types verify-legacy-assets.mjs",
    "verify:legacy-routes": "node --experimental-strip-types verify-legacy-forum-routes.mjs",
    "verify:legacy-signatures": "node --experimental-strip-types verify-legacy-signature-floor-links.mjs",
    "verify:markdown-editing": "node --experimental-strip-types verify-markdown-editing.mjs",
    "verify:markdown-rendering": "node --experimental-strip-types verify-markdown-rendering.mjs",
    "verify:rich-text-indentation": "node --experimental-strip-types verify-rich-text-indentation.mjs",
    "verify:table-to-vcf": "node --experimental-strip-types verify-table-to-vcf.mjs",
    "verify:tag-expression": "node --experimental-strip-types verify-tag-expression.mjs",
    "verify:thread-publishing": "node --experimental-strip-types verify-thread-publishing.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.561.0",
    "markdown-it": "^15.0.1",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "7.3.3"
  }
}
