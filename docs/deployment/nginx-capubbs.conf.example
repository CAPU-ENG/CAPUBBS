server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /var/www/capubbs;
    index index.php index.html;
    charset utf-8;
    client_max_body_size 32m;

    location = / {
        try_files /forum/index.html =404;
    }

    location /assets/ {
        try_files /forum$uri $uri =404;
    }

    location /forum/ {
        try_files $uri $uri/ /forum/index.html;
    }

    location / {
        try_files /forum$uri $uri $uri/ /forum/index.html;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.5-fpm.sock;
    }

    location = /config.php {
        deny all;
    }

    location = /config.sample.php {
        deny all;
    }

    location = /capubbs.sql {
        deny all;
    }

    location ~ /\.(?!well-known/) {
        deny all;
    }
}
